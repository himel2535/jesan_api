// Core platform tables only. Business-data tables come later and must each
// carry a businessId column with indexes that start with businessId.
// Connection URLs live in prisma.config.ts (Prisma 7), not here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// One row per business run on the platform. Business-specific differences
/// (unit, principal supplier, labels) live in `config`, never in code.
model Business {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  nameEn    String   @map("name_en") @db.VarChar(120)
  nameBn    String   @map("name_bn") @db.VarChar(120)
  /// Module template key, e.g. "dealership". A string, not an enum, so a new
  /// template needs no migration.
  type      String   @db.VarChar(32)
  config    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  access            UserBusinessAccess[]
  rolePermissions   RolePermission[]
  auditLogs         AuditLog[]
  documentCounters  DocumentCounter[]
  productCategories ProductCategory[]
  products          Product[]
  customers         Customer[]
  suppliers         Supplier[]
  changeRequests    ChangeRequest[]
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  stockMovements    StockMovement[]
  purchaseCounters  MonthlyPurchaseCounter[]

  @@map("businesses")
}

/// A person who can sign in. At least one of email/phone is required
/// (CHECK constraint in the migration); both are unique when present.
model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase (CHECK constraint in the migration).
  email             String?   @unique @db.VarChar(254)
  phone             String?   @unique @db.VarChar(20)
  name              String    @db.VarChar(120)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  isActive          Boolean   @default(true) @map("is_active")
  /// The company owner: may enter every business and holds every permission,
  /// including the owner-only ones (commission, profit, management).
  isPlatformOwner   Boolean   @default(false) @map("is_platform_owner")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  access    UserBusinessAccess[]
  sessions  Session[]
  auditLogs AuditLog[]

  createdCategories ProductCategory[] @relation("createdCategories")
  createdProducts   Product[]         @relation("createdProducts")
  createdCustomers  Customer[]        @relation("createdCustomers")
  createdSuppliers  Supplier[]        @relation("createdSuppliers")
  updatedCategories ProductCategory[] @relation("updatedCategories")
  updatedProducts   Product[]         @relation("updatedProducts")
  updatedCustomers  Customer[]        @relation("updatedCustomers")
  updatedSuppliers  Supplier[]        @relation("updatedSuppliers")
  requestedChanges  ChangeRequest[]   @relation("requestedChanges")
  decidedChanges    ChangeRequest[]   @relation("decidedChanges")
  createdPurchases  Purchase[]        @relation("createdPurchases")
  updatedPurchases  Purchase[]        @relation("updatedPurchases")
  voidedPurchases   Purchase[]        @relation("voidedPurchases")
  stockMovements    StockMovement[]

  @@map("users")
}

/// Role definitions are platform-wide; which role a user holds is per business.
model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(32)
  nameEn    String   @map("name_en") @db.VarChar(60)
  nameBn    String   @map("name_bn") @db.VarChar(60)
  isSystem  Boolean  @default(false) @map("is_system")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  access          UserBusinessAccess[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Which user may enter which business, and with which role there.
model UserBusinessAccess {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // One role per user per business; also serves "businesses of this user".
  @@unique([userId, businessId])
  // "Users of this business" and the business_id foreign key.
  @@index([businessId, roleId])
  // role_id foreign key.
  @@index([roleId])
  @@map("user_business_access")
}

/// Every permission the code declares (mirrored here at startup).
/// Rows are never deleted: a permission that leaves the code is only deactivated.
model Permission {
  key       String   @id @db.VarChar(100)
  module    String   @db.VarChar(32)
  /// Owner-only permissions can be held by the platform owner alone. The
  /// role_permissions table cannot reference them (see its CHECK constraint).
  ownerOnly Boolean  @map("owner_only")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  // Target of the composite foreign key from role_permissions.
  @@unique([key, ownerOnly])
  @@map("permissions")
}

/// Which permissions a role has inside one business. The business-level
/// "owner" role and the platform owner have no rows here: their permissions
/// are computed from the permission list.
model RolePermission {
  businessId          String   @map("business_id") @db.Uuid
  roleId              String   @map("role_id") @db.Uuid
  permissionKey       String   @map("permission_key") @db.VarChar(100)
  /// Always false: a CHECK constraint (added in the migration) plus the
  /// composite foreign key keep owner-only permissions out of this table.
  permissionOwnerOnly Boolean  @default(false) @map("permission_owner_only")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionKey, permissionOwnerOnly], references: [key, ownerOnly], onDelete: Restrict)

  @@id([businessId, roleId, permissionKey])
  // role_id foreign key.
  @@index([roleId])
  // permission foreign key.
  @@index([permissionKey, permissionOwnerOnly])
  @@map("role_permissions")
}

/// One row per signed-in device. Only the SHA-256 of the refresh token is stored.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  /// The token before the last rotation: seeing it again means it was copied.
  previousTokenHash String?   @map("previous_token_hash") @db.Char(64)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(32)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ip                String?   @db.VarChar(45)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousTokenHash])
  @@map("sessions")
}

/// Append-only record of security-relevant changes. No API edits or deletes it.
/// `changes` holds only the changed fields (before and after), never passwords.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events (for example a session theft detection).
  businessId  String?  @map("business_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  changes     Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Next number per business, document type and period (a year, or 0 for master
/// data). Incremented with one atomic INSERT ... ON CONFLICT ... RETURNING inside
/// the transaction that uses the number: never count(*) or max() + 1.
model DocumentCounter {
  businessId String   @map("business_id") @db.Uuid
  docType    String   @map("doc_type") @db.VarChar(32)
  period     Int      @default(0)
  lastValue  BigInt   @map("last_value")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([businessId, docType, period])
  @@map("document_counters")
}

// ---------------------------------------------------------------------------
// Dealership module: master data. Every table here is business data: always
// queried through PrismaService.forBusiness(businessId). Never deleted, only
// deactivated. Case-insensitive unique names and the one-principal-supplier rule are
// added in the migration SQL (Prisma cannot express them).
// ---------------------------------------------------------------------------

model ProductCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  nameEn     String   @map("name_en") @db.VarChar(120)
  nameBn     String   @map("name_bn") @db.VarChar(120)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid
  /// Bumped on every change; a change request is stale when it no longer matches.
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator  User?     @relation("createdCategories", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?     @relation("updatedCategories", fields: [updatedBy], references: [id], onDelete: Restrict)
  products Product[]

  // Target of the composite foreign key from products (same business only).
  @@unique([businessId, id])
  @@index([businessId, isActive, sortOrder])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("product_categories")
}

model Product {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  /// Generated from document_counters, e.g. P-0001. Never changes.
  code              String    @db.VarChar(32)
  categoryId        String    @map("category_id") @db.Uuid
  nameEn            String    @map("name_en") @db.VarChar(120)
  nameBn            String    @map("name_bn") @db.VarChar(120)
  /// One of the unit keys in the business config (Akij: "bag").
  unitKey           String    @map("unit_key") @db.VarChar(16)
  /// Rate of the latest valid purchase; read-only, set by purchases in the
  /// same transaction (Step 5a). Null until the first purchase. Hidden
  /// without product.cost.view.
  lastPurchasePrice Decimal?  @map("last_purchase_price") @db.Decimal(14, 2)
  lastPurchasedAt   DateTime? @map("last_purchased_at") @db.Timestamptz(3)
  /// Stock on hand, kept in the same transaction as every stock movement; equals
  /// the sum of the product's movements. Never negative (CHECK).
  currentStock      Decimal   @default(0) @map("current_stock") @db.Decimal(14, 3)
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  /// Bumped on every change; a change request is stale when it no longer matches.
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category ProductCategory @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  creator  User?           @relation("createdProducts", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?           @relation("updatedProducts", fields: [updatedBy], references: [id], onDelete: Restrict)

  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@unique([businessId, code])
  // Target of composite foreign keys from business data (same-business rows only).
  @@unique([businessId, id])
  @@index([businessId, categoryId])
  // Matches the list order (name, then id) so pages are read straight from the index.
  @@index([businessId, isActive, nameEn, id])
  @@index([createdBy])
  @@index([updatedBy])
  // Trigram indexes for "contains" search (pg_trgm, created in the migration).
  @@index([nameEn(ops: raw("gin_trgm_ops"))], map: "products_name_en_trgm_idx", type: Gin)
  @@index([nameBn(ops: raw("gin_trgm_ops"))], map: "products_name_bn_trgm_idx", type: Gin)
  @@index([code(ops: raw("gin_trgm_ops"))], map: "products_code_trgm_idx", type: Gin)
  @@map("products")
}

model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  /// Generated from document_counters, e.g. C-00001. Never changes.
  code           String   @db.VarChar(32)
  nameEn         String   @map("name_en") @db.VarChar(120)
  nameBn         String?  @map("name_bn") @db.VarChar(120)
  /// Required, E.164 (+8801XXXXXXXXX), unique within the business.
  phone          String   @db.VarChar(20)
  address        String?  @db.VarChar(255)
  area           String?  @db.VarChar(80)
  /// Positive: the customer owes us. Negative: an advance we owe them.
  openingBalance Decimal  @map("opening_balance") @db.Decimal(14, 2)
  /// Kept up to date in the same transaction as every sale and collection,
  /// so due lists never add up all transactions.
  currentBalance Decimal  @map("current_balance") @db.Decimal(14, 2)
  /// Null means no limit.
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  /// Bumped on every change; a change request is stale when it no longer matches.
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator  User?    @relation("createdCustomers", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?    @relation("updatedCustomers", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([businessId, code])
  @@unique([businessId, phone])
  // Matches the list order (name, then id) so pages are read straight from the index.
  @@index([businessId, isActive, nameEn, id])
  @@index([businessId, currentBalance])
  @@index([createdBy])
  @@index([updatedBy])
  // Trigram indexes for "contains" search (pg_trgm, created in the migration).
  @@index([nameEn(ops: raw("gin_trgm_ops"))], map: "customers_name_en_trgm_idx", type: Gin)
  @@index([nameBn(ops: raw("gin_trgm_ops"))], map: "customers_name_bn_trgm_idx", type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "customers_phone_trgm_idx", type: Gin)
  @@index([code(ops: raw("gin_trgm_ops"))], map: "customers_code_trgm_idx", type: Gin)
  @@map("customers")
}

model Supplier {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  code        String   @db.VarChar(32)
  nameEn      String   @map("name_en") @db.VarChar(120)
  nameBn      String   @map("name_bn") @db.VarChar(120)
  phone       String?  @db.VarChar(20)
  address     String?  @db.VarChar(255)
  /// The principal supplier of a dealership (one per business, enforced by a
  /// partial unique index in the migration).
  isPrincipal Boolean  @default(false) @map("is_principal")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  /// Bumped on every change; a change request is stale when it no longer matches.
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator  User?    @relation("createdSuppliers", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?    @relation("updatedSuppliers", fields: [updatedBy], references: [id], onDelete: Restrict)

  purchases Purchase[]

  @@unique([businessId, code])
  @@unique([businessId, id])
  @@index([businessId, isActive, nameEn])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("suppliers")
}

/// A request to edit or void a record, decided by someone else (maker-checker).
/// Business data: always used through PrismaService.forBusiness(businessId).
/// One pending request per record (partial unique index in the migration).
model ChangeRequest {
  id             String    @id @default(uuid(7)) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  /// Registered handler key, e.g. "product", later "sale".
  entityType     String    @map("entity_type") @db.VarChar(48)
  entityId       String    @map("entity_id") @db.Uuid
  /// Short human label for lists, e.g. "P-0001 Sample OPC 50kg".
  entityLabel    String    @map("entity_label") @db.VarChar(160)
  /// "edit" or "void".
  kind           String    @db.VarChar(8)
  reason         String    @db.VarChar(500)
  /// The record's version when requested; a different version means stale.
  baseVersion    Int       @map("base_version")
  /// Values of the affected fields when requested (only those fields).
  snapshot       Json
  /// The requested new values (edit only).
  proposedChange Json?     @map("proposed_change")
  /// "pending", "approved", "rejected", "cancelled" or "stale".
  status         String    @default("pending") @db.VarChar(12)
  requestedBy    String    @map("requested_by") @db.Uuid
  decidedBy      String?   @map("decided_by") @db.Uuid
  decisionNote   String?   @map("decision_note") @db.VarChar(500)
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(64)
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  requester User     @relation("requestedChanges", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider   User?    @relation("decidedChanges", fields: [decidedBy], references: [id], onDelete: Restrict)

  // Approver inbox and the pending badge.
  @@index([businessId, status, requestedAt])
  // "My requests".
  @@index([businessId, requestedBy, requestedAt])
  // History of one record.
  @@index([businessId, entityType, entityId])
  @@index([requestedBy])
  @@index([decidedBy])
  @@map("change_requests")
}

// ---------------------------------------------------------------------------
// Dealership module: purchases and stock (Step 5a). Business data: always
// through PrismaService.forBusiness(businessId). Nothing is deleted: purchases
// are voided, stock movements are append-only (a trigger refuses UPDATE and
// DELETE). Composite foreign keys keep every row inside one business.
// ---------------------------------------------------------------------------

/// A cash purchase from a supplier (the principal supplier by default).
model Purchase {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  /// From document_counters, e.g. PUR-0001. Never changes.
  code              String    @db.VarChar(32)
  supplierId        String    @map("supplier_id") @db.Uuid
  /// The business's calendar date (its time zone, Asia/Dhaka by default).
  purchaseDate      DateTime  @map("purchase_date") @db.Date
  /// Only "cash" for now: every purchase is fully paid.
  paymentMethod     String    @default("cash") @map("payment_method") @db.VarChar(16)
  totalQuantity     Decimal   @map("total_quantity") @db.Decimal(14, 3)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(14, 2)
  /// active or void (CHECK in the migration).
  status            String    @default("active") @db.VarChar(8)
  note              String?   @db.VarChar(500)
  /// The supplier's own paper number, if any.
  supplierReference String?   @map("supplier_reference") @db.VarChar(64)
  idempotencyKey    String?   @map("idempotency_key") @db.VarChar(64)
  /// Bumped on every change; a change request is stale when it no longer matches.
  version           Int       @default(1)
  createdBy         String    @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  voidedBy          String?   @map("voided_by") @db.Uuid
  voidedAt          DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason        String?   @map("void_reason") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier Supplier       @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict)
  creator  User           @relation("createdPurchases", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?          @relation("updatedPurchases", fields: [updatedBy], references: [id], onDelete: Restrict)
  voider   User?          @relation("voidedPurchases", fields: [voidedBy], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@unique([businessId, code])
  @@unique([businessId, id])
  // The list: newest first.
  @@index([businessId, purchaseDate(sort: Desc), id(sort: Desc)])
  @@index([businessId, supplierId, purchaseDate(sort: Desc)])
  @@index([businessId, status, purchaseDate(sort: Desc)])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([voidedBy])
  @@map("purchases")
}

/// One product on a purchase. purchase_date and status are copied from the
/// purchase (kept equal in the same transaction) so the last valid purchase of
/// a product is one index lookup.
model PurchaseItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  purchaseId   String   @map("purchase_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  quantity     Decimal  @db.Decimal(14, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(14, 2)
  /// round(quantity * unit_price, 2), half up (CHECK in the migration).
  lineTotal    Decimal  @map("line_total") @db.Decimal(14, 2)
  purchaseDate DateTime @map("purchase_date") @db.Date
  status       String   @default("active") @db.VarChar(8)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchase Purchase @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict)
  product  Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@unique([purchaseId, productId])
  @@index([businessId, purchaseId])
  @@index([businessId, productId, purchaseDate(sort: Desc), createdAt(sort: Desc)])
  @@map("purchase_items")
}

/// Append-only stock ledger. quantity is signed; balance_after is the product's
/// stock right after this movement (computed under the product row lock).
model StockMovement {
  id           String   @id @default(uuid(7)) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  /// purchase, purchase_edit, purchase_void, adjustment (Step 5b adds delivery, delivery_void).
  kind         String   @db.VarChar(16)
  quantity     Decimal  @db.Decimal(14, 3)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(14, 3)
  /// The business date it counts on: the purchase date, or the day of a void, edit or adjustment.
  movementDate DateTime @map("movement_date") @db.Date
  /// What caused it: "purchase" with the purchase id, or "adjustment" (no id).
  sourceType   String   @map("source_type") @db.VarChar(16)
  sourceId     String?  @map("source_id") @db.Uuid
  reason       String?  @db.VarChar(500)
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  // A product's history, newest first.
  @@index([businessId, productId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([businessId, movementDate])
  @@index([businessId, sourceType, sourceId])
  @@index([createdBy])
  @@map("stock_movements")
}

/// Bags bought per month (by purchase date), for commission progress. Changed
/// only by one atomic upsert in the purchase's transaction. Owner-only to read.
model MonthlyPurchaseCounter {
  businessId String   @map("business_id") @db.Uuid
  /// YYYYMM, e.g. 202611.
  period     Int
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([businessId, period])
  @@map("monthly_purchase_counters")
}
