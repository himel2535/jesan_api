// Core platform tables only. Business-data tables come later and must each
// carry a businessId column with indexes that start with businessId.
// Connection URLs live in prisma.config.ts (Prisma 7), not here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// One row per business run on the platform. Business-specific differences
/// (unit, principal supplier, labels) live in `config`, never in code.
model Business {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  nameEn    String   @map("name_en") @db.VarChar(120)
  nameBn    String   @map("name_bn") @db.VarChar(120)
  /// Module template key, e.g. "dealership". A string, not an enum, so a new
  /// template needs no migration.
  type      String   @db.VarChar(32)
  config    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  access            UserBusinessAccess[]
  rolePermissions   RolePermission[]
  auditLogs         AuditLog[]
  documentCounters  DocumentCounter[]
  productCategories ProductCategory[]
  products          Product[]
  customers         Customer[]
  suppliers         Supplier[]

  @@map("businesses")
}

/// A person who can sign in. At least one of email/phone is required
/// (CHECK constraint in the migration); both are unique when present.
model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase (CHECK constraint in the migration).
  email             String?   @unique @db.VarChar(254)
  phone             String?   @unique @db.VarChar(20)
  name              String    @db.VarChar(120)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  isActive          Boolean   @default(true) @map("is_active")
  /// The company owner: may enter every business and holds every permission,
  /// including the owner-only ones (commission, profit, management).
  isPlatformOwner   Boolean   @default(false) @map("is_platform_owner")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  access    UserBusinessAccess[]
  sessions  Session[]
  auditLogs AuditLog[]

  createdCategories ProductCategory[]
  createdProducts   Product[]
  createdCustomers  Customer[]
  createdSuppliers  Supplier[]

  @@map("users")
}

/// Role definitions are platform-wide; which role a user holds is per business.
model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(32)
  nameEn    String   @map("name_en") @db.VarChar(60)
  nameBn    String   @map("name_bn") @db.VarChar(60)
  isSystem  Boolean  @default(false) @map("is_system")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  access          UserBusinessAccess[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Which user may enter which business, and with which role there.
model UserBusinessAccess {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // One role per user per business; also serves "businesses of this user".
  @@unique([userId, businessId])
  // "Users of this business" and the business_id foreign key.
  @@index([businessId, roleId])
  // role_id foreign key.
  @@index([roleId])
  @@map("user_business_access")
}

/// Every permission the code declares (mirrored here at startup).
/// Rows are never deleted: a permission that leaves the code is only deactivated.
model Permission {
  key       String   @id @db.VarChar(100)
  module    String   @db.VarChar(32)
  /// Owner-only permissions can be held by the platform owner alone. The
  /// role_permissions table cannot reference them (see its CHECK constraint).
  ownerOnly Boolean  @map("owner_only")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  // Target of the composite foreign key from role_permissions.
  @@unique([key, ownerOnly])
  @@map("permissions")
}

/// Which permissions a role has inside one business. The business-level
/// "owner" role and the platform owner have no rows here: their permissions
/// are computed from the permission list.
model RolePermission {
  businessId          String   @map("business_id") @db.Uuid
  roleId              String   @map("role_id") @db.Uuid
  permissionKey       String   @map("permission_key") @db.VarChar(100)
  /// Always false: a CHECK constraint (added in the migration) plus the
  /// composite foreign key keep owner-only permissions out of this table.
  permissionOwnerOnly Boolean  @default(false) @map("permission_owner_only")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionKey, permissionOwnerOnly], references: [key, ownerOnly], onDelete: Restrict)

  @@id([businessId, roleId, permissionKey])
  // role_id foreign key.
  @@index([roleId])
  // permission foreign key.
  @@index([permissionKey, permissionOwnerOnly])
  @@map("role_permissions")
}

/// One row per signed-in device. Only the SHA-256 of the refresh token is stored.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  /// The token before the last rotation: seeing it again means it was copied.
  previousTokenHash String?   @map("previous_token_hash") @db.Char(64)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(32)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ip                String?   @db.VarChar(45)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousTokenHash])
  @@map("sessions")
}

/// Append-only record of security-relevant changes. No API edits or deletes it.
/// `changes` holds only the changed fields (before and after), never passwords.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events (for example a session theft detection).
  businessId  String?  @map("business_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  changes     Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Next number per business, document type and period (a year, or 0 for master
/// data). Incremented with one atomic INSERT ... ON CONFLICT ... RETURNING inside
/// the transaction that uses the number: never count(*) or max() + 1.
model DocumentCounter {
  businessId String   @map("business_id") @db.Uuid
  docType    String   @map("doc_type") @db.VarChar(32)
  period     Int      @default(0)
  lastValue  BigInt   @map("last_value")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([businessId, docType, period])
  @@map("document_counters")
}

// ---------------------------------------------------------------------------
// Dealership module: master data. Every table here is business data: always
// queried through PrismaService.forBusiness(businessId). Never deleted, only
// deactivated. Case-insensitive unique names and the one-principal-supplier rule are
// added in the migration SQL (Prisma cannot express them).
// ---------------------------------------------------------------------------

model ProductCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  nameEn     String   @map("name_en") @db.VarChar(120)
  nameBn     String   @map("name_bn") @db.VarChar(120)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator  User?     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  products Product[]

  // Target of the composite foreign key from products (same business only).
  @@unique([businessId, id])
  @@index([businessId, isActive, sortOrder])
  @@index([createdBy])
  @@map("product_categories")
}

model Product {
  id               String   @id @default(uuid(7)) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  /// Generated from document_counters, e.g. P-0001. Never changes.
  code             String   @db.VarChar(32)
  categoryId       String   @map("category_id") @db.Uuid
  nameEn           String   @map("name_en") @db.VarChar(120)
  nameBn           String   @map("name_bn") @db.VarChar(120)
  /// One of the unit keys in the business config (Akij: "bag").
  unitKey          String   @map("unit_key") @db.VarChar(16)
  /// Current cost price. Hidden without product.cost.view.
  purchasePrice    Decimal  @map("purchase_price") @db.Decimal(14, 2)
  /// Default selling price; each sale may use another price.
  defaultSalePrice Decimal  @map("default_sale_price") @db.Decimal(14, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category ProductCategory @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  creator  User?           @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([businessId, code])
  @@index([businessId, categoryId])
  // Matches the list order (name, then id) so pages are read straight from the index.
  @@index([businessId, isActive, nameEn, id])
  @@index([createdBy])
  // Trigram indexes for "contains" search (pg_trgm, created in the migration).
  @@index([nameEn(ops: raw("gin_trgm_ops"))], map: "products_name_en_trgm_idx", type: Gin)
  @@index([nameBn(ops: raw("gin_trgm_ops"))], map: "products_name_bn_trgm_idx", type: Gin)
  @@index([code(ops: raw("gin_trgm_ops"))], map: "products_code_trgm_idx", type: Gin)
  @@map("products")
}

model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  /// Generated from document_counters, e.g. C-00001. Never changes.
  code           String   @db.VarChar(32)
  nameEn         String   @map("name_en") @db.VarChar(120)
  nameBn         String?  @map("name_bn") @db.VarChar(120)
  /// Required, E.164 (+8801XXXXXXXXX), unique within the business.
  phone          String   @db.VarChar(20)
  address        String?  @db.VarChar(255)
  area           String?  @db.VarChar(80)
  /// Positive: the customer owes us. Negative: an advance we owe them.
  openingBalance Decimal  @map("opening_balance") @db.Decimal(14, 2)
  /// Kept up to date in the same transaction as every sale and collection,
  /// so due lists never add up all transactions.
  currentBalance Decimal  @map("current_balance") @db.Decimal(14, 2)
  /// Null means no limit.
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([businessId, code])
  @@unique([businessId, phone])
  // Matches the list order (name, then id) so pages are read straight from the index.
  @@index([businessId, isActive, nameEn, id])
  @@index([businessId, currentBalance])
  @@index([createdBy])
  // Trigram indexes for "contains" search (pg_trgm, created in the migration).
  @@index([nameEn(ops: raw("gin_trgm_ops"))], map: "customers_name_en_trgm_idx", type: Gin)
  @@index([nameBn(ops: raw("gin_trgm_ops"))], map: "customers_name_bn_trgm_idx", type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "customers_phone_trgm_idx", type: Gin)
  @@index([code(ops: raw("gin_trgm_ops"))], map: "customers_code_trgm_idx", type: Gin)
  @@map("customers")
}

model Supplier {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  code        String   @db.VarChar(32)
  nameEn      String   @map("name_en") @db.VarChar(120)
  nameBn      String   @map("name_bn") @db.VarChar(120)
  phone       String?  @db.VarChar(20)
  address     String?  @db.VarChar(255)
  /// The principal supplier of a dealership (one per business, enforced by a
  /// partial unique index in the migration).
  isPrincipal Boolean  @default(false) @map("is_principal")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([businessId, code])
  @@index([businessId, isActive, nameEn])
  @@index([createdBy])
  @@map("suppliers")
}
