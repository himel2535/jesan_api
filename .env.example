# Copy this file to .env and adjust. Never put real secrets in this file.
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# PostgreSQL. Optional in development and test, required when NODE_ENV=production.
# DATABASE_URL: pooled connection, used by the running app (Neon: the "-pooler" host).
# DIRECT_URL:   direct connection, used only for migrations (Neon: host without "-pooler").
# Put the real values only in your local .env, never here.
DATABASE_URL=
DIRECT_URL=

# Sign-in
# JWT_ACCESS_SECRET: signs access tokens, at least 32 random characters. Required in production.
#   Elsewhere a temporary one is made at start-up (sign-ins end when the app restarts).
#   Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# COOKIE_DOMAIN: set to the shared parent domain (e.g. example.com) when the web app and
#   the API are on subdomains of it. Leave empty for localhost or when proxying through Next.js.
COOKIE_DOMAIN=
# TRUST_PROXY: number of reverse proxies in front of the API (so the real client IP is used).
TRUST_PROXY=0
# LOGIN_RATE_LIMIT: sign-in attempts allowed per IP address per minute.
LOGIN_RATE_LIMIT=10

# Only for the one-time command `npm run admin:create` (first platform owner).
# Put the real values in your local .env, run the command, then delete ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_NAME=
ADMIN_PASSWORD=
